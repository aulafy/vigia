# Copy to .env and fill in. Real environment variables take precedence over this file.

# --- Language of alerts and dashboard: en | es ---
VIGIA_LANG=en

# --- Alert channels (configure at least one) ---
# ntfy: install the ntfy app on your phone and subscribe to a long, unguessable topic.
NTFY_TOPIC=vigia-change-me-to-something-long-and-random
# NTFY_SERVER=https://ntfy.sh      # or your self-hosted ntfy
# NTFY_TOKEN=                      # access token for protected topics
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Generic JSON webhook (PagerDuty, Better Stack, Opsgenie, Twilio…) for phone calls and escalation
# WEBHOOK_URL=

# --- Watch the watcher ---
# Ping URL from healthchecks.io (free) or a Better Stack heartbeat. Vigía calls it every minute;
# if the pings stop (Vigía crashed, machine off, network down) THAT service alerts you.
# HEARTBEAT_URL=https://hc-ping.com/your-uuid

# --- Acknowledge from the phone (optional) ---
# Public HTTPS URL where Vigía is reachable, plus a random secret used to sign ack links.
# Generate a secret with: openssl rand -hex 32
# PUBLIC_URL=https://vigia.example.com
# ACK_SECRET=

# --- Dashboard ---
PORT=4848
# HOST=127.0.0.1     # use 0.0.0.0 only behind a VPN, tunnel or reverse proxy
# DASH_PASS=         # enables HTTP Basic auth, user "vigia"

# --- Daily digest ---
DIGEST_HOUR=9
DIGEST_TZ=Europe/Madrid
