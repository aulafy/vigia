# Copy to .env and fill in. Real environment variables take precedence over this file.

# --- Language of alerts and dashboard: en | es ---
VIGIA_LANG=en

# --- Alert channels (configure at least one) ---
# ntfy: install the ntfy app on your phone and subscribe to a long, unguessable topic.
NTFY_TOPIC=vigia-change-me-to-something-long-and-random
# NTFY_SERVER=https://ntfy.sh      # or your self-hosted ntfy
# NTFY_TOKEN=                      # access token for protected topics
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Generic JSON webhook (PagerDuty, Better Stack, Opsgenie, Twilio…) for phone calls and escalation
# WEBHOOK_URL=
# Email (docs/alerts.md#email): 465 = implicit TLS, 587 = STARTTLS. Gmail/Workspace need an app password.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASS=
# MAIL_FROM="Vigía <alerts@example.com>"
# MAIL_TO=you@example.com,colleague@example.com

# --- Watch the watcher ---
# Ping URL from healthchecks.io (free) or a Better Stack heartbeat. Vigía calls it every minute;
# if the pings stop (Vigía crashed, machine off, network down) THAT service alerts you.
# HEARTBEAT_URL=https://hc-ping.com/your-uuid
# When every alert channel fails, Vigía calls HEARTBEAT_URL/fail instead (override below if your service differs)
# HEARTBEAT_FAIL_URL=
# Weekly test alert you must acknowledge; unacknowledged = broken alert chain. 0 disables.
CANARY_DAYS=7
CANARY_ACK_HOURS=24

# --- WordPress vulnerabilities (docs/inventory-push.md) ---
# Free key: https://www.wordfence.com/products/wordfence-intelligence/
# WORDFENCE_API_KEY=
# WORDFENCE_HOURS=6

# --- Backup check-ins and inventory pushes (docs/backups.md, docs/inventory-push.md) ---
# Generate with: openssl rand -hex 32
# CHECKIN_SECRET=
# Servers use per-asset keys: node server.mjs key <asset-id>. The master secret itself is rejected unless:
# CHECKIN_ALLOW_MASTER=true   # only for migrating from older versions
# Computers added with the install line (docs/computers.md) also need CHECKIN_SECRET, and a PUBLIC_URL they can reach.
# ENROLL_DAYS=7              # how long an install line stays valid

# --- Acknowledge from the phone (optional) ---
# Public HTTPS URL where Vigía is reachable, plus a random secret used to sign ack links.
# Generate a secret with: openssl rand -hex 32
# PUBLIC_URL=https://vigia.example.com
# ACK_SECRET=

# --- Connectivity probe: if none answers, Vigía is offline and skips the uptime round ---
# CONNECTIVITY_URLS=https://www.cloudflare.com/cdn-cgi/trace,https://1.1.1.1/

# --- Early warning and reports (docs/edge.md, docs/reports.md) ---
# EPSS_P1=0.5
# EPSS_P2=0.1
# REPORT_BRAND=Your IT company

# --- Local AI (optional): "Explain" and client drafts on every alert (docs/ai.md) ---
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_URL=http://127.0.0.1:11434   # Docker Desktop: http://host.docker.internal:11434

# --- Dashboard ---
PORT=4848
# HOST=127.0.0.1     # use 0.0.0.0 only behind a VPN, tunnel or reverse proxy
# DASH_PASS=         # HTTP Basic auth, user "vigia". Required when HOST is not local (Docker included)
# ALLOW_NO_PASSWORD=true  # only if a proxy in front already authenticates
# DASH_HOSTS=        # without DASH_PASS, extra host names allowed to open the dashboard

# --- DNS check ---
# DNS_SERVERS=1.1.1.1,8.8.8.8

# --- Acknowledge links and edge devices ---
# ACK_LINK_DAYS=7            # acknowledge links in notifications expire after this
# EDGE_VERSION_DAYS=60       # ask to confirm a declared firmware version after this
# ADVISORY_MAX_AGE_DAYS=45   # ignore advisories and research posts older than this

# --- Daily digest ---
DIGEST_HOUR=9
DIGEST_TZ=Europe/Madrid
